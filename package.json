{
  "name": "priv-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @priv-kit/website build",
    "check": "pnpm -r --sort check",
    "dev": "pnpm --filter @priv-kit/website dev",
    "preview": "pnpm --filter @priv-kit/website preview"
  },
  "devDependencies": {
    "@js-joda/core": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/subset-font": "catalog:",
    "es-module-lexer": "catalog:",
    "priv-playground": "workspace:*",
    "subset-font": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    }
  }
}

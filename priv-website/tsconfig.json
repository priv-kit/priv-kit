{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "rootDir": "./"
  },
  "include": [
    ".vitepress/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "guide/**/*.vue",
    "zh/guide/**/*.vue"
  ]
}
